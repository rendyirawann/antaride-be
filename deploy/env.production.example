# ==============================================================================
#  Antaride — .env PRODUKSI
# ==============================================================================
#  Salin ke /var/www/antaride-be/.env lalu isi yang bertanda GANTI.
#
#      sudo -u www-data cp deploy/env.production.example .env
#      sudo -u www-data php artisan key:generate
#      sudo chmod 600 .env
#
#  chmod 600 bukan formalitas: berkas ini memuat kunci enkripsi database. APP_KEY
#  yang bocor berarti seluruh kolom terenkripsi — NIK, nomor SIM, nomor rekening
#  — bisa dibaca siapa pun yang punya salinan database.
# ==============================================================================

APP_NAME=Antaride
APP_ENV=production

# GANTI: php artisan key:generate
APP_KEY=

# ------------------------------------------------------------------------------
#  APP_DEBUG=false — DAN INI YANG PALING BERBAHAYA KALAU SALAH
# ------------------------------------------------------------------------------
#  Dengan true, setiap galat menampilkan halaman Ignition yang memuat: seluruh
#  isi .env (termasuk APP_KEY dan password database), potongan kode sumber, dan
#  isi variabel di setiap frame stack trace — termasuk password yang baru
#  dikirim pengguna lewat form login.
#
#  Halaman itu tidak menuntut autentikasi apa pun. Satu galat 500 di endpoint
#  mana pun sudah cukup.
APP_DEBUG=false

APP_TIMEZONE=UTC
BUSINESS_TIMEZONE=Asia/Jakarta

# ==============================================================================
#  APP_URL — INI YANG MENENTUKAN SUBFOLDER
# ==============================================================================
#  HARUS memuat subfolder, dan HARUS https.
#
#  Yang memakainya:
#
#    * URL bertanda tangan dokumen KYC. config/filesystems.php menyusun jalur
#      disk `kyc` dari APP_URL — kalau subfolder-nya hilang di sini, setiap
#      pratinjau dokumen di panel verifikasi menghasilkan 404, dan tim
#      verifikasi tidak bisa bekerja.
#
#    * Callback payment gateway (DUITKU_CALLBACK_URL memakai ${APP_URL}).
#      Subfolder yang hilang berarti gateway memanggil URL yang tidak ada, dan
#      pembayaran yang sudah dibayar penumpang tidak pernah tercatat.
#
#    * Seluruh perintah artisan dan job queue. Di luar konteks HTTP tidak ada
#      request untuk dibaca, jadi Laravel memakai APP_URL apa adanya.
#
#  TANPA garis miring di akhir. Laravel menambahkannya sendiri; dengan garis
#  miring hasilnya `//` di tengah path.
#
#  Untuk deploy di AKAR/subdomain, hilangkan subfolder-nya:
#      APP_URL=https://api.domain-anda.id
#
#  GANTI:
APP_URL=https://domain-anda.id/antaride

# ==============================================================================
#  TRUSTED_PROXIES — PASANGAN WAJIB APP_URL DI ATAS
# ==============================================================================
#  Nginx berada di host yang SAMA dengan Octane, jadi 127.0.0.1 sudah cukup.
#
#  JANGAN diganti `*`. Header X-Forwarded-* semuanya bisa dipalsukan client, dan
#  mempercayai siapa pun berarti:
#
#    * X-Forwarded-For palsu melewati rate limit OTP dan allowlist IP admin
#    * X-Forwarded-Host palsu membuat tautan reset password yang dikirim ke
#      email KORBAN menunjuk ke domain penyerang — pengambilalihan akun dengan
#      satu header HTTP
#
#  Kalau ada Cloudflare atau load balancer di depan, TAMBAHKAN rentang IP-nya
#  di sini, jangan diganti `*`.
#
#  Dijaga tests/Feature/Http/SubfolderDeploymentTest.php.
TRUSTED_PROXIES=127.0.0.1,::1

# ------------------------------------------------------------------------------
#  Subdomain (kosongkan kalau memakai subfolder)
# ------------------------------------------------------------------------------
#  Kalau diisi, route admin dan API pindah ke subdomain masing-masing dan
#  prefix /admin tidak dipakai lagi.
ADMIN_DOMAIN=
API_DOMAIN=

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
#  Log
# ------------------------------------------------------------------------------
#  `daily` bukan `single`: berkas log tunggal tumbuh sampai gigabyte dan tidak
#  ada yang memutarnya. Yang terjadi kemudian: disk penuh, dan yang berhenti
#  bukan hanya log — PostgreSQL berhenti menerima tulisan.
#
#  LOG_LEVEL=warning: `debug` di produksi menulis setiap query dan setiap
#  request. Selain memenuhi disk, isinya memuat data pribadi pengguna.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ------------------------------------------------------------------------------
#  PostgreSQL
# ------------------------------------------------------------------------------
#  Port 5432 di server (bawaan), BUKAN 5433 seperti di lokal. 5433 dipakai di
#  lokal karena XAMPP sudah memakai port lain — di server tidak ada alasannya.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=antaride

# GANTI: JANGAN memakai user `postgres`.
#
# User superuser bisa DROP DATABASE, membaca seluruh database lain di instance
# yang sama, dan menjalankan COPY FROM PROGRAM — yang berarti eksekusi perintah
# shell. Satu SQL injection pada koneksi superuser adalah seluruh server.
#
#     sudo -u postgres createuser --pwprompt antaride
#     sudo -u postgres createdb --owner=antaride antaride
DB_USERNAME=antaride
DB_PASSWORD=GANTI_DENGAN_PASSWORD_PANJANG_ACAK
DB_SCHEMA=public

DB_READ_HOST=127.0.0.1
DB_READ_PORT=5432

# `postgis` kalau ekstensinya sudah terpasang, `native` kalau belum.
#
# Salah di sini TIDAK menghasilkan galat saat boot: `antaride:health` yang
# menandainya GAGAL. Jalankan perintah itu setelah deploy.
GEO_ZONE_DRIVER=postgis

# ------------------------------------------------------------------------------
#  Redis
# ------------------------------------------------------------------------------
#  `phpredis` di produksi, bukan `predis`.
#
#  predis murni PHP: setiap perintah diurai di PHP. Dengan 250 ping GPS per
#  detik ditambah cache dan antrean, bedanya terasa. predis dipakai di lokal
#  hanya karena ekstensi phpredis tidak terpasang di sana.
#
#      sudo apt install php8.3-redis
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# GANTI: harus SAMA dengan `requirepass` di deploy/redis/antaride.conf DAN
# dengan ANTARIDE_REDIS_PASSWORD di /etc/antaride/location.env.
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_PANJANG_ACAK

REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

# ------------------------------------------------------------------------------
#  REDIS_GEO_COMMAND — PERIKSA VERSI REDIS DI SERVER
# ------------------------------------------------------------------------------
#  `georadius` untuk Redis 5 dan 6.0. `geosearch` untuk 6.2+.
#
#  Redis lokal 5.0.14 tidak punya GEOSEARCH, jadi lokal memakai `georadius`.
#  Server dengan Redis 7 (bawaan Ubuntu 24.04) bisa memakai `geosearch`, yang
#  lebih cepat dan tidak deprecated.
#
#  Periksa:  redis-cli -a PASSWORD INFO server | grep redis_version
#
#  Kalau salah: GEOSEARCH di Redis 5 menghasilkan "unknown command", dan yang
#  gagal adalah PENCOCOKAN DRIVER — order masuk lalu langsung no_driver.
REDIS_GEO_COMMAND=geosearch

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true

# ==============================================================================
#  SESSION_PATH — IKUT SUBFOLDER
# ==============================================================================
#  Untuk deploy di subfolder, ini HARUS subfolder-nya, bukan `/`.
#
#  Alasannya: cookie dengan path `/` dikirim ke SELURUH aplikasi di domain yang
#  sama. Kalau ada aplikasi Laravel lain di /aplikasi-lain, keduanya memakai
#  nama cookie yang sama (`laravel_session`) dan saling menimpa — dan gejalanya
#  staf yang "keluar sendiri" setiap kali berpindah antar aplikasi.
#
#  Untuk deploy di akar/subdomain, kembalikan ke `/`.
SESSION_PATH=/antaride

SESSION_DOMAIN=null

# `true` WAJIB di HTTPS. Tanpa itu cookie sesi admin dikirim juga lewat HTTP
# biasa, dan siapa pun di jaringan yang sama bisa membacanya.
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_SESSION_ABSOLUTE_MINUTES=720

# ------------------------------------------------------------------------------
#  Octane
# ------------------------------------------------------------------------------
#  OCTANE_HTTPS=true.
#
#  Nginx yang memegang TLS, jadi Octane sendiri melihat HTTP. Tanpa ini, URL
#  yang dihasilkan di dalam worker Octane berskema http:// walaupun
#  X-Forwarded-Proto sudah dipercaya — Octane menyetel skemanya sendiri saat
#  worker dijalankan.
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=true

# ------------------------------------------------------------------------------
#  Layanan lokasi (Go)
# ------------------------------------------------------------------------------
#  URL yang dikirim ke aplikasi driver. Aplikasi memakainya APA ADANYA, jadi
#  harus bisa dijangkau dari internet — bukan 127.0.0.1.
#
#  Dua pilihan:
#    a. subdomain sendiri:  https://loc.domain-anda.id
#    b. subfolder di Nginx yang sama, di-proxy ke 127.0.0.1:8200
#
#  Pilihan (a) lebih sederhana dan yang disarankan: layanan ini menerima 250
#  request per detik yang tidak butuh apa pun dari Nginx selain TLS.
LOCATION_SERVICE_URL=https://loc.domain-anda.id

# GANTI: nilai acak, dan HARUS SAMA dengan ANTARIDE_LOCATION_SECRET di
# /etc/antaride/location.env.
#
# Kalau berbeda, SETIAP ping ditolak 401 — dan tidak ada galat di mana pun.
# Yang terlihat: driver online yang tidak pernah mendapat order.
#
#     openssl rand -hex 32
LOCATION_SERVICE_SECRET=GANTI_DENGAN_HASIL_openssl_rand_hex_32

# ------------------------------------------------------------------------------
#  Centrifugo (belum terpasang — aplikasi jatuh ke penarikan berkala)
# ------------------------------------------------------------------------------
CENTRIFUGO_URL=http://127.0.0.1:8100
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_TOKEN_TTL=3600

# ------------------------------------------------------------------------------
#  OSRM
# ------------------------------------------------------------------------------
#  Tanpa OSRM, perhitungan jarak dan ETA tidak jalan — dan tanpa jarak tidak ada
#  harga. Ini bukan komponen opsional.
OSRM_URL=http://127.0.0.1:5000
OSRM_TIMEOUT=3
OSRM_PROFILE=driving

GOOGLE_PLACES_KEY=
GOOGLE_PLACES_CACHE_DAYS=30

# ------------------------------------------------------------------------------
#  Payment gateway (ditunda — biarkan kosong)
# ------------------------------------------------------------------------------
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox
DUITKU_CALLBACK_URL="${APP_URL}/webhooks/duitku/callback"

FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_ENV=sandbox

# ------------------------------------------------------------------------------
#  Push notification (ditunda — diganti notifikasi in-app)
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/private/fcm-service-account.json

# ------------------------------------------------------------------------------
#  Penyimpanan
# ------------------------------------------------------------------------------
#  KYC_DISK HARUS `kyc`, bukan `public`.
#
#  Disk `public` dilayani web server langsung dari `public/storage`. Menaruh
#  KTP, SIM, dan foto selfie di sana berarti siapa pun yang menebak nama berkas
#  bisa mengunduhnya — dan nama berkasnya ada di response API kalau
#  pemeriksaannya pernah dilewati.
FILESYSTEM_DISK=local
KYC_DISK=kyc
EXPORT_DISK=exports
