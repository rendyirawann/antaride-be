# ==============================================================================
#  ANTARIDE BACKEND — Environment
# ------------------------------------------------------------------------------
#  Local dev di Windows. Semua host memakai 127.0.0.1, bukan localhost, supaya
#  tidak kena resolusi IPv6 (::1) yang membuat koneksi Postgres/Redis lambat.
# ==============================================================================

APP_NAME=Antaride
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# JANGAN diubah dari UTC.
#
# Seluruh timestamp disimpan UTC supaya tidak bergantung setelan server.
# Zona bisnis (WIB) diatur terpisah lewat BUSINESS_TIMEZONE di bawah, dan
# dipakai untuk perbandingan jam bisnis: jadwal surge, jam buka merchant,
# batas hari untuk agregasi.
APP_TIMEZONE=UTC

# Zona untuk keputusan bisnis. Dibaca App\Domain\Shared\Support\BusinessClock.
BUSINESS_TIMEZONE=Asia/Jakarta
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ------------------------------------------------------------------------------
#  Entry point
# ------------------------------------------------------------------------------
#  Produksi memakai subdomain terpisah (blueprint admin bagian 13):
#    ADMIN_DOMAIN=admin.antaride.id   API_DOMAIN=api.antaride.id
#  Di lokal keduanya null, jadi admin hidup di prefix /admin dan API di /api/v1.
ADMIN_DOMAIN=
API_DOMAIN=

# ------------------------------------------------------------------------------
#  Log
# ------------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
#  Database — PostgreSQL 18 (port 5433)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=antaride
DB_USERNAME=postgres
DB_PASSWORD=
DB_SCHEMA=public

#  Read replica. Semua query panel admin diarahkan ke sini (blueprint admin
#  bagian 5). Di lokal diarahkan ke host yang sama; di produksi ke replica asli.
DB_READ_HOST=127.0.0.1
DB_READ_PORT=5433

#  Driver resolusi zona: postgis (ST_Contains) atau native (ray-casting di PHP).
#  Pakai postgis begitu ekstensinya terpasang; native hanya untuk fallback dev.
GEO_ZONE_DRIVER=postgis

# ------------------------------------------------------------------------------
#  Redis
# ------------------------------------------------------------------------------
#  predis dipakai di dev karena ekstensi php_redis belum terpasang di Windows.
#  Di produksi ganti ke phpredis, bedanya nyata di jalur ping GPS.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2

#  Redis 5.0 (build Windows) tidak punya GEOSEARCH yang baru ada di 6.2.
#  Set ke "georadius" untuk Redis < 6.2, "geosearch" untuk 6.2+.
REDIS_GEO_COMMAND=georadius

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

#  Blueprint admin bagian 3: idle 2 jam, absolute 12 jam untuk sesi admin.
ADMIN_SESSION_IDLE_MINUTES=120
ADMIN_SESSION_ABSOLUTE_MINUTES=720

# ------------------------------------------------------------------------------
#  Octane — RoadRunner
# ------------------------------------------------------------------------------
#  Swoole tidak punya build Windows dan FrankenPHP masih eksperimental di sana,
#  jadi dev memakai RoadRunner. Produksi Linux bisa pindah ke frankenphp hanya
#  dengan mengubah nilai ini.
OCTANE_SERVER=roadrunner
OCTANE_HTTPS=false

# Host, port, dan jumlah worker Octane adalah FLAG CLI, bukan config.
# Diatur di dev.bat dan di perintah octane:start, bukan di sini. Menaruhnya di
# .env tidak berpengaruh apa pun, dan itu menyesatkan.
#   php artisan octane:start --host=127.0.0.1 --port=8000 --workers=4

# ------------------------------------------------------------------------------
#  Realtime — Centrifugo
# ------------------------------------------------------------------------------
CENTRIFUGO_URL=http://127.0.0.1:8100
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_HMAC_SECRET=
CENTRIFUGO_TOKEN_TTL=3600

# ------------------------------------------------------------------------------
#  Location Service (Go)
# ------------------------------------------------------------------------------
#  Ping GPS TIDAK masuk Laravel. Service ini menerima ping, validasi kewajaran,
#  tulis ke Redis, publish ke Centrifugo. Tanpa write ke Postgres.
LOCATION_SERVICE_URL=http://127.0.0.1:8200
LOCATION_SERVICE_TOKEN=

# ------------------------------------------------------------------------------
#  Routing & Maps
# ------------------------------------------------------------------------------
#  OSRM self-host untuk semua perhitungan jarak dan tarif (dipanggil ribuan kali
#  per hari). Google Places hanya untuk autocomplete yang di-debounce & di-cache.
OSRM_URL=http://127.0.0.1:5000
OSRM_TIMEOUT=3
OSRM_PROFILE=driving

GOOGLE_PLACES_KEY=
GOOGLE_PLACES_CACHE_DAYS=30

# ------------------------------------------------------------------------------
#  Payment
# ------------------------------------------------------------------------------
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
DUITKU_ENV=sandbox
DUITKU_CALLBACK_URL="${APP_URL}/webhooks/duitku/callback"

# Hanya Flip yang diimplementasikan. Kalau nanti ada provider kedua,
# tambahkan pemilihannya di config/services.php lebih dulu.
FLIP_SECRET_KEY=
FLIP_VALIDATION_TOKEN=
FLIP_ENV=sandbox

# ------------------------------------------------------------------------------
#  Push — FCM HTTP v1
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=storage/app/private/fcm-service-account.json

# ------------------------------------------------------------------------------
#  Storage
# ------------------------------------------------------------------------------
#  Dokumen KYC masuk disk privat, bukan public. Diakses lewat signed URL.
FILESYSTEM_DISK=local

# Disk dokumen KYC. WAJIB privat: KTP, SIM, STNK, dan selfie hanya boleh
# diakses lewat signed URL berumur pendek.
KYC_DISK=kyc
EXPORT_DISK=exports
PUBLIC_DISK=public

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=true

# ------------------------------------------------------------------------------
#  Mail
# ------------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@antaride.id"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
#  OTP & Keamanan
# ------------------------------------------------------------------------------
OTP_LENGTH=4
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_SANDBOX_CODE=1234

#  Blueprint bagian 3: 2FA wajib untuk finance & superadmin, tanpa pengecualian.
ADMIN_2FA_REQUIRED=true
ADMIN_IP_ALLOWLIST_ENABLED=false

# ------------------------------------------------------------------------------
#  Matching (blueprint bagian 4.3)
# ------------------------------------------------------------------------------
MATCHING_INITIAL_RADIUS_M=2000
MATCHING_MAX_RADIUS_M=8000
MATCHING_RADIUS_MULTIPLIER=1.6
MATCHING_MAX_WAVES=4
MATCHING_OFFER_TTL_SECONDS=15
MATCHING_WAVE1_CANDIDATES=3
MATCHING_WAVE_N_CANDIDATES=5

#  Bobot skoring: jarak, rating, acceptance, keadilan-idle, cancellation.
MATCHING_WEIGHT_DISTANCE=0.45
MATCHING_WEIGHT_RATING=0.15
MATCHING_WEIGHT_ACCEPTANCE=0.15
MATCHING_WEIGHT_IDLE=0.20
MATCHING_WEIGHT_CANCELLATION=0.05

# ------------------------------------------------------------------------------
#  Anti fake GPS (blueprint bagian 5)
# ------------------------------------------------------------------------------
GPS_MAX_SPEED_KMH=150
GPS_MAX_ACCURACY_M=100
GPS_MOCK_SUSPEND_THRESHOLD=5
GPS_GEOFENCE_ARRIVAL_M=100

# ------------------------------------------------------------------------------
#  Frontend (Vite untuk aset panel admin)
# ------------------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
